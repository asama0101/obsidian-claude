filters:
  and:
    - type == "project"
    - '!file.folder.contains("80_Templates")'
properties:
  start_date:
    displayName: 開始日
  due_date:
    displayName: 期限
views:
  - type: table
    name: Active
    filters: '!file.inFolder("50_Archives")'
    order:
      - file.name
      - start_date
      - due_date
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 219
  - type: table
    name: All
    order:
      - file.name
      - start_date
      - due_date
