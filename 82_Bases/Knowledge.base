filters:
  or:
    - type == "knowhow"
    - type == "webclip"
views:
  - type: table
    name: All
    filters:
      and:
        - '!file.folder.contains("80_Templates")'
    order:
      - file.name
      - tags
  - type: table
    name: ByCategory
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
