filters:
  and:
    - type == "task"
    - '!file.folder.contains("80_Templates")'
properties:
  status:
    displayName: ステータス
  project:
    displayName: プロジェクト
  created_date:
    displayName: 作成日
  start_date:
    displayName: 開始日
  due_date:
    displayName: 期限
  memo:
    displayName: メモ
views:
  - type: table
    name: Today
    filters:
      or:
        - and:
            - status == "4_done"
            - start_date == if(/^\d{4}-\d{2}-\d{2}$/.matches(this.file.basename), date(this.file.basename + " 00:00:00"), today())
        - and:
            - status != "4_done"
            - status != "5_cancel"
            - start_date <= if(/^\d{4}-\d{2}-\d{2}$/.matches(this.file.basename), date(this.file.basename + " 00:00:00"), today())
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - status
      - start_date
      - due_date
      - memo
    sort:
      - property: project
        direction: ASC
      - property: start_date
        direction: ASC
      - property: due_date
        direction: ASC
    columnSize:
      file.name: 349
  - type: table
    name: ScheduleCheck
    filters:
      and:
        - status != "4_done"
        - status != "5_cancel"
        - or:
            - "!start_date"
            - start_date <= if(/^\d{4}-\d{2}-\d{2}$/.matches(this.file.basename), date(this.file.basename + " 00:00:00"), today()) + "14d"
    groupBy:
      property: start_date
      direction: ASC
    order:
      - file.name
      - project
      - status
      - start_date
      - due_date
      - memo
    sort:
      - property: project
        direction: ASC
    columnSize:
      note.status: 113
  - type: table
    name: ProjectTasks
    filters:
      and:
        - project == link(this.file.name)
        - status != "4_done"
        - status != "5_cancel"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - start_date
      - due_date
      - memo
    sort:
      - property: due_date
        direction: ASC
      - property: start_date
        direction: ASC
    columnSize:
      file.name: 423
  - type: table
    name: ProjectCompletedTasks
    filters:
      and:
        - project == link(this.file.name)
        - status == "4_done"
    order:
      - file.name
      - status
      - due_date
      - memo
    sort:
      - property: due_date
        direction: ASC
    columnSize:
      file.name: 144
  - type: table
    name: All
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - project
      - start_date
      - due_date
      - memo
    sort:
      - property: project
        direction: ASC
      - property: start_date
        direction: ASC
      - property: due_date
        direction: ASC
