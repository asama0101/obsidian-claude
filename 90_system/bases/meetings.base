filters:
  and:
    - file.inFolder("70_meetings")
    - type == "meeting"
views:
  - type: table
    name: 今日
    filters:
      and:
        - date(date) == if(/^\d{4}-\d{2}-\d{2}/.matches(this.file.name), date(this.file.name), today())
    order:
      - file.name
      - project
      - location
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: プロジェクト
    filters:
      and:
        - project == link(this.file.name)
    order:
      - file.name
      - date
      - location
    sort:
      - property: date
        direction: DESC
