filters:
  and:
    - or:
        - file.inFolder("20_tasks")
        - file.inFolder("00_inbox")
    - type == "task"
views:
  - type: table
    name: 未完了（期限順）
    filters:
      or:
        - status == "todo"
        - status == "in_progress"
        - status == "waiting"
        - status == "requested"
    order:
      - file.name
      - status
      - project
      - start
      - due
      - memo
    sort:
      - property: due
        direction: ASC
  - type: table
    name: プロジェクト別
    filters:
      or:
        - status == "todo"
        - status == "in_progress"
        - status == "waiting"
        - status == "requested"
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - status
      - start
      - due
      - memo
    sort:
      - property: due
        direction: ASC
  - type: table
    name: アイデア
    filters:
      and:
        - status == "idea"
    order:
      - file.name
      - project
      - created
      - memo
    sort:
      - property: created
        direction: DESC
  - type: table
    name: 塩漬け・中止
    filters:
      or:
        - status == "shelved"
        - status == "cancelled"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - created
      - memo
    sort:
      - property: created
        direction: DESC
  - type: table
    name: 要修正
    # 進めるタスクなのに日付が空のもの
    filters:
      and:
        - or:
            - status == "todo"
            - status == "in_progress"
            - status == "waiting"
            - status == "requested"
        - or:
            - start.isEmpty()
            - due.isEmpty()
    order:
      - file.name
      - status
      - project
      - start
      - due
  - type: table
    name: 完了
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - project
      - completed
    sort:
      - property: completed
        direction: DESC
