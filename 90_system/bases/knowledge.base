filters:
  and:
    - or:
        - type == "knowledge"
        - type == "research"
        - type == "decision"
        - type == "mistake"
    - '!file.inFolder("90_system")'
formulas:
  種類: 'if(file.inFolder("80_context/knowledge"), "技術知見（80_context）", if(type == "decision", "判断記録", if(type == "mistake", "失敗記録", if(type == "research", "research", "knowledge"))))'
views:
  - type: table
    name: 全件
    groupBy:
      property: formula.種類
      direction: ASC
    order:
      - file.name
      - tags
      - project
      - source
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: 判断・失敗
    filters:
      or:
        - type == "decision"
        - type == "mistake"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - project
      - date
      - tags
    sort:
      - property: date
        direction: DESC
