filters:
  and:
    - or:
        - file.inFolder("20_tasks")
        - file.inFolder("00_inbox")
    - type == "task"
    - project == link(this.file.name)
views:
  - type: table
    name: 関連タスク
    order:
      - file.name
      - status
      - start
      - due
      - completed
    sort:
      - property: due
        direction: ASC
