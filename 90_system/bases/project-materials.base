filters:
  and:
    - file.path != this.file.path
    - '!file.inFolder("90_system")'
    - or:
        - and:
            - or:
                - type == "knowledge"
                - type == "doc"
            - project == link(this.file.name)
        - file.inFolder(this.file.folder)
formulas:
  種類: if(type, type, file.ext)
views:
  - type: table
    name: 知識・資料
    groupBy:
      property: formula.種類
      direction: ASC
    order:
      - file.name
      - tags
      - file.folder
      - created
    sort:
      - property: file.mtime
        direction: DESC
