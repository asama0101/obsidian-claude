filters:
  and:
    - type == "task"
    - '!file.folder.contains("70_Templates")'
properties:
  status:
    displayName: ステータス
  project:
    displayName: プロジェクト
  start_date:
    displayName: 開始日
  due_date:
    displayName: 期限
  memo:
    displayName: メモ
views:
  - type: table
    name: Today
    filters:
      and:
        - start_date
        - start_date <= if(/^\d{4}-\d{2}-\d{2}$/.matches(this.file.basename), date(this.file.basename + " 00:00:00"), today())
        - status != "4_done"
        - status != "5_cancel"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - status
      - start_date
      - due_date
      - memo
    sort:
      - property: status
        direction: ASC
      - property: project
        direction: ASC
  - type: table
    name: ProjectTasks
    filters:
      and:
        - project == link(this.file.name)
        - status != "4_done"
        - status != "5_cancel"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - start_date
      - due_date
      - memo
    sort:
      - property: due_date
        direction: ASC
    columnSize:
      file.name: 150
  - type: table
    name: ProjectCompletedTasks
    filters:
      and:
        - project == link(this.file.name)
        - status == "4_done"
    order:
      - file.name
      - status
      - due_date
      - memo
    columnSize:
      file.name: 144
  - type: table
    name: All
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - project
      - start_date
      - due_date
      - memo
