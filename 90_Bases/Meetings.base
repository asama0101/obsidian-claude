filters:
  or:
    - type == "meeting"
    - type == "meeting_series"
properties:
  project:
    displayName: プロジェクト
  date:
    displayName: 開催日（単発）
  last_updated:
    displayName: 最終更新日（定例）
  attendance:
    displayName: 出席状況
views:
  - type: table
    name: Today
    filters:
      or:
        - and:
            - type == "meeting"
            - date == today()
        - and:
            - type == "meeting_series"
            - last_updated == today()
    order:
      - file.name
      - project
      - type
      - attendance
  - type: table
    name: ProjectMeetings
    filters: project == link(this.file.name)
    order:
      - file.name
      - type
      - date
      - last_updated
      - attendance
